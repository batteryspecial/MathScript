{
    "$schema": "https://turborepo.com/schema.json",
    "globalEnv": [
        "DATABASE_URL",
        "DIRECT_URL",
        "BETTER_AUTH_URL",
        "BETTER_AUTH_SECRET",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GIT_CLIENT_ID",
        "GIT_CLIENT_SECRET"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "inputs": ["src/**", "package.json", "tsconfig.json"],
            "outputs": ["dist/**"]
        }
    }
}
